# Server-only. Never prefix this with VITE_ or commit its real value.
GEMINI_API_KEY=
# Public Firebase browser key, supplied at runtime. Use a Firebase-only restricted
# key, never a Gemini key. Its value is delivered to browsers but kept out of Git.
FIREBASE_WEB_API_KEY=
# Documented model; confirm availability for your project before deployment.
GEMINI_MODEL=gemini-3.6-flash
PORT=3000
# Must match firebase-applet-config.json and the database in firebase.json.
GOOGLE_CLOUD_PROJECT=gen-lang-client-0501741319
FIRESTORE_DATABASE_ID=ai-studio-geminijournalref-ad8029a5-768c-440f-a60c-f1264ae41063
# Local server authentication: use Application Default Credentials.
# Cloud Run uses its attached service account; do not upload a credential file.
